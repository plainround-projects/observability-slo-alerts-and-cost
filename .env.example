# Copy to .env (make up does this). Local-only values; nothing here is a real secret.
GRAFANA_ADMIN_PASSWORD=local-only-grafana

# make run switches the gateway between observability/collector/gateway.raw.yaml and gateway.yaml itself.
GATEWAY_CONFIG=./observability/collector/gateway.yaml

# Host ports (everything is bound to 127.0.0.1 only).
SERVICE_HOST_PORT=28083
GRAFANA_HOST_PORT=23000
PROMETHEUS_HOST_PORT=29090
REPLAY_HOST_PORT=29091
TEMPO_HOST_PORT=23200
LOKI_HOST_PORT=23100
PAGER_HOST_PORT=28084
GATEWAY_HEALTH_HOST_PORT=23133
